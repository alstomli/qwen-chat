# Supabase public client settings; see docs/accounts.md for required migration/setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set these after deploying the included Runpod chat gateway.
# Use HTTPS in production. Never prefix credentials with NEXT_PUBLIC_.
RUNPOD_BF16_CHAT_URL=
RUNPOD_BF16_CHAT_TOKEN=

# Server-side opt-in in any environment; also enable on the updated gateway.
CHAT_DIAGNOSTICS_ENABLED=false
